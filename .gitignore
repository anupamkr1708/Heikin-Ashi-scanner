# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
*.pem
*.key

# Data (raw/processed/cache are regenerated locally — never commit market data or DB files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
*.duckdb

# Reports and logs (regenerated per run)
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
