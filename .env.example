# Copy this file to .env and fill in values as needed. Nothing in this repository currently
# requires a secret to run the baseline scanner (NSE's public EOD reports and Yahoo Finance's
# public endpoints need no API key). This file exists so that if you extend the system with a
# broker connector, a paid data vendor, or notification webhooks, credentials have a documented
# home that is never committed to source control (see .gitignore).

# Example placeholders for future extensions (PART 60 — no broker integration exists yet):
# BROKER_API_KEY=
# BROKER_API_SECRET=
# NOTIFICATION_WEBHOOK_URL=

# Optional: override any config.py field via environment variable, e.g.:
# NSE_SCANNER__RESEARCH__RUN_RESEARCH_MODE=true
# NSE_SCANNER__UNIVERSE__UNIVERSE_SCOPE=NIFTY_200
